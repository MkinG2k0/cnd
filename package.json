{
  "name": "cnd",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/ensure-git-lfs-assets.mjs && next build",
    "build:capacitor": "node scripts/build-capacitor.mjs",
    "cap:icons": "node scripts/generate-capacitor-icons.mjs",
    "cap:keystore": "node scripts/create-capacitor-keystore.mjs",
    "cap:sync": "npm run build:capacitor && npx cap sync android",
    "cap:open": "npx cap open android",
    "cap:release": "npm run cap:icons && npm run cap:sync && npm run cap:keystore && cd android && .\\gradlew.bat assembleRelease bundleRelease",
    "start": "next start",
    "lint": "eslint",
    "test:telegram-enrich": "npx --yes tsx --test scripts/telegram-enrich/topic-map.test.ts scripts/telegram-enrich/classify-media.test.ts scripts/telegram-enrich/text.test.ts scripts/telegram-enrich/build-manifest.test.ts scripts/telegram-enrich/apply-safety.test.ts scripts/telegram-enrich/cli.test.ts",
    "enrich:telegram": "npx --yes tsx scripts/enrich-from-telegram.ts",
    "enrich:telegram:apply": "npm --prefix studio-cnd run enrich:telegram -- --apply"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/status-bar": "^8.0.4",
    "@keystatic/core": "^0.6.9",
    "@keystatic/next": "^5.0.5",
    "@sanity/client": "^8.15.1",
    "@sanity/image-url": "^2.1.1",
    "next": "^16.4.6",
    "next-sanity": "^13.3.4",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
